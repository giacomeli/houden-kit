{
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "types": ["vitest/globals", "node", "vite/client"],
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "target": "ES2022"
    },
    "include": ["src", "tests", "scripts", "*.ts"],
    "exclude": ["node_modules", "dist", ".parity", "playground", "tests/consumer"]
}
