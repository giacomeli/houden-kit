{
    "name": "houden-kit",
    "version": "0.1.0",
    "description": "Biblioteca de componentes React com Tailwind CSS 4 e DaisyUI 5: temas claro e escuro, formulários, tabela, layout, painel e chat",
    "license": "MIT",
    "author": "Juliano Giacomeli",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/giacomeli/houden-kit.git"
    },
    "homepage": "https://github.com/giacomeli/houden-kit#readme",
    "bugs": {
        "url": "https://github.com/giacomeli/houden-kit/issues"
    },
    "keywords": [
        "react",
        "ui-kit",
        "tailwindcss",
        "daisyui",
        "components"
    ],
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./components/Layout/RouteProgressBar": {
            "types": "./dist/components/Layout/RouteProgressBar.d.ts",
            "import": "./dist/components/Layout/RouteProgressBar.js"
        },
        "./components/TanStackTable/TanStackPaginationBar": {
            "types": "./dist/components/TanStackTable/TanStackPaginationBar.d.ts",
            "import": "./dist/components/TanStackTable/TanStackPaginationBar.js"
        },
        "./components/TanStackTable/useLegacyTanStackTable": {
            "types": "./dist/components/TanStackTable/useLegacyTanStackTable.d.ts",
            "import": "./dist/components/TanStackTable/useLegacyTanStackTable.js"
        },
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "import": "./dist/components/*/index.js"
        },
        "./icons": {
            "types": "./dist/icons/index.d.ts",
            "import": "./dist/icons/index.js"
        },
        "./table": {
            "types": "./dist/table/index.d.ts",
            "import": "./dist/table/index.js"
        },
        "./theme.css": "./dist/theme.css",
        "./fonts.css": "./dist/fonts.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json && node scripts/fix-dts-specifiers.mjs && node scripts/copy-css.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:dist": "vitest run --config vitest.dist.config.ts",
        "check:package": "publint && node scripts/attw.mjs",
        "check:consumer": "node scripts/consumer-smoke.mjs",
        "parity:extract": "node scripts/parity-extract.mjs",
        "parity:generate": "node scripts/parity-generate.mjs",
        "changeset": "changeset",
        "release": "npm run build && changeset publish",
        "playground:dev": "npm run build && npm --prefix playground run dev",
        "playground:build": "npm run build && npm --prefix playground run build && node playground/scripts/check-gallery.mjs",
        "playground:preview": "npm --prefix playground run preview",
        "playground:check-csp": "node playground/scripts/check-csp.mjs"
    },
    "peerDependencies": {
        "react": "^19",
        "react-dom": "^19",
        "react-hook-form": "^7",
        "tailwindcss": "^4.1"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@react-input/mask": "^2.0.4",
        "@tanstack/react-table": "^8.21.3",
        "chart.js": "^4.4.3",
        "daisyui": "5.5.14",
        "lucide-react": "^1.45.0",
        "react-currency-mask": "^1.3.2",
        "react-dropzone": "^14.2.3",
        "react-markdown": "^10.1.0",
        "react-toastify": "^10.0.5",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@biomejs/biome": "2.4.12",
        "@changesets/cli": "^3.0.3",
        "@tailwindcss/vite": "4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "jsdom": "^29.0.2",
        "publint": "^0.3.25",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.71.1",
        "react-router": "^7.18.4",
        "rollup-preserve-directives": "^1.1.3",
        "tailwindcss": "4.1.18",
        "typescript": "~5.9.3",
        "vite": "~7.3.7",
        "vitest": "^4.1.4"
    }
}
